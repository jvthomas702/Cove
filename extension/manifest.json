{
  "manifest_version": 3,
  "name": "Cove for ChatGPT, Claude & Gemini",
  "short_name": "Cove",
  "version": "1.1.0",
  "description": "Shows live ChatGPT, Claude and Gemini browser activity, reply previews and completions in Cove on your Mac.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Cove",
    "default_popup": "popup.html"
  }
}
