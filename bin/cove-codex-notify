#!/usr/bin/env bash
# Codex `notify` program → Cove. Codex passes the event JSON as the last argument.
payload="${!#}"
[ $# -eq 0 ] && exit 0
printf '%s' "$payload" | curl -s -m 1 -X POST \
  -H 'Content-Type: application/json' -H 'Expect:' \
  --data-binary @- "http://127.0.0.1:${COVE_PORT:-7777}/hook/codex" >/dev/null 2>&1
exit 0
